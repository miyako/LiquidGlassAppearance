{
  "$comment": "Document-specific settings. Run `make inspect` and review; see tools/config.py for all keys and defaults.",
  "source_lang": "en",
  "target_lang": "ja",
  "page_size": "letter",
  "accent_color": "#2f5496",
  "cover": {
    "page": 1,
    "lines": 3
  },
  "skip_pages": [1, 2, 3],
  "footer_y": 714,
  "heading": {
    "fonts": ["HelveticaNeue-Medium"],
    "min_size": 12.0,
    "levels_by_x": {"72": 2, "90": 3, "108": 4}
  },
  "code": {
    "colors": [],
    "fonts": ["SegoeUIHistoric", "Menlo"]
  },
  "bullets": {
    "fonts": ["SymbolMT"]
  },
  "caption": {
    "italic": false,
    "fonts": ["TimesNewRomanPS-Bold"],
    "min_x": 70
  },
  "quote": {
    "italic": true
  },
  "table": {
    "ruled": true
  },
  "ocr": {
    "engine": "vision"
  }
}
